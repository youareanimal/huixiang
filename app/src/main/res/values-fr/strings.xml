    <string name="ui_admin_desc">Le menu d’une personne permet aussi de la déplacer vers un autre canal, de l’expulser du canal ou du serveur et de la bannir. Le serveur décide si vous en avez le droit : sans la permission, il refuse.</string>

    <!-- Settings › Advanced -->
    <string name="relay_title">Connexion vidéo</string>
    <string name="relay_desc">Les diffusions passent directement entre vous et l’autre côté. Derrière certains réseaux, elles ont besoin d’un relais (un serveur TURN) : saisissez-en un ici si vous en avez un.</string>
    <string name="relay_address">Relais (turn:hôte:port)</string>
    <string name="relay_user">Nom d’utilisateur du relais</string>
    <string name="relay_password">Mot de passe du relais</string>
    <string name="relay_only">Toujours passer par le relais</string>
    <string name="advanced_file_port">Un serveur dont le transfert de fichiers est sur un autre port (ses images et avatars ne se chargent pas) peut avoir son propre port dans la partie Avancé du favori.</string>
    <string name="passwords_title">Mots de passe des canaux</string>
    <string name="passwords_desc">Les mots de passe que vous avez choisi de retenir rejoignent leurs canaux d’un seul toucher. Ils sont conservés chiffrés sur ce téléphone.</string>
    <string name="passwords_forget">Oublier les mots de passe enregistrés</string>
    <string name="passwords_forgotten">Oubliés.</string>
    <string name="identity_title">Identité TeamSpeak</string>
    <string name="identity_desc">Votre identité est ce que vous êtes pour les serveurs (vos groupes et permissions). Gardez-en une copie, ou utilisez celle d’une autre app TeamSpeak.</string>
    <string name="identity_wipe">Effacer</string>
    <string name="identity_export">Exporter</string>
    <string name="identity_import">Importer</string>
    <string name="identity_imported">Importée. Elle est utilisée à partir de la prochaine connexion.</string>
    <string name="identity_saved">Enregistrée. Gardez le fichier là où vous seul y avez accès.</string>
    <string name="identity_wiped">Effacée. Une nouvelle identité est créée à la prochaine connexion.</string>
    <string name="identity_export_title">Exporter votre identité</string>
    <string name="identity_export_subtitle">Gardez-la privée</string>
    <string name="identity_save_file">Enregistrer dans un fichier</string>
    <string name="identity_export_what">Le fichier est votre identité elle-même : quiconque l’a est vous sur chaque serveur, avec vos groupes et permissions, comme ceux d’un administrateur du serveur. Personne ne peut faire la différence.</string>
    <string name="identity_export_where">Enregistrez-le là où vous seul y avez accès, comme ce téléphone ou un espace de stockage privé. Ne l’envoyez pas dans un chat ou un e-mail, et ne le publiez pas. Une app TeamSpeak peut l’ouvrir, tout comme 回响 sur un autre téléphone.</string>
    <string name="identity_wipe_title">Effacer votre identité ?</string>
    <string name="identity_wipe_what">L’identité de ce téléphone est supprimée, et une nouvelle est créée à votre prochaine connexion. Pour chaque serveur, vous êtes alors quelqu’un de nouveau : vos groupes, vos permissions et tout ce qui a été donné à votre ancienne identité (comme des droits d’administrateur) ne suivent pas.</string>
    <string name="identity_wipe_back">Le seul moyen de revenir en arrière est une copie exportée. Si vous risquez d’en avoir besoin, annulez et exportez-la d’abord.</string>
    <string name="identity_import_title">Importer une identité</string>
    <string name="identity_import_subtitle">Depuis une app TeamSpeak</string>
    <string name="identity_import_desc">Collez l’identité qu’une app TeamSpeak a exportée, ou choisissez le fichier qu’elle a enregistré (.ini). Elle remplace celle de ce téléphone à partir de la prochaine connexion.</string>
    <string name="identity_field">Identité</string>
    <string name="identity_choose_file">Choisir un fichier…</string>
    <string name="level_title">Niveau de sécurité</string>
    <string name="level_desc">Certains serveurs n’acceptent que les identités d’au moins un certain niveau. L’augmenter garde la même identité, avec ses groupes et permissions.</string>
