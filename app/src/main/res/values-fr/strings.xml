    <!-- Settings › UI -->
    <string name="ui_admin">Afficher les fonctions d’administration</string>
    <string name="ui_controls_bottom">Boutons en bas</string>
    <string name="ui_controls_bottom_desc">Les boutons micro, son et partage et le sélecteur Canaux/Chat se trouvent en bas de l’écran, à portée de votre pouce.</string>
    <string name="ui_language">Langue</string>
