    <plurals name="history_lines">
        <item quantity="one">%1$d ligne</item>
        <item quantity="many">%1$d lignes</item>
        <item quantity="other">%1$d lignes</item>
    </plurals>
    <string name="history_clear">Effacer l’historique du chat</string>
    <string name="history_cleared">Effacé.</string>
    <string name="history_clear_title">Effacer l’historique du chat ?</string>
    <string name="history_clear_button">Effacer</string>
    <string name="history_clear_desc">Le chat enregistré de tous les serveurs est supprimé de ce téléphone, ainsi que le chat affiché en ce moment.</string>

