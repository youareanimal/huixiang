    <string name="capture_echo_desc">La cancelación de eco reproduce las voces como en una llamada (altavoz o tus auriculares con micrófono). Desactívala para el mejor sonido con auriculares.</string>

    <!-- Settings › UI -->
    <string name="ui_admin">Mostrar funciones de administración</string>
    <string name="ui_controls_bottom">Botones abajo</string>
    <string name="ui_controls_bottom_desc">Los botones de micrófono, sonido y compartir y el selector Canales/Chat están en la parte inferior de la pantalla, al alcance de tu pulgar.</string>
    <string name="ui_language">Idioma</string>
