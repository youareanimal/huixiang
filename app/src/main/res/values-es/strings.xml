    <string name="ui_admin_desc">El menú de una persona también ofrece moverla a otro canal, expulsarla del canal o del servidor y banearla. El servidor decide si puedes hacerlo: sin el permiso, lo rechaza.</string>

    <!-- Settings › Advanced -->
    <string name="relay_title">Conexión de vídeo</string>
    <string name="relay_desc">Las transmisiones van directamente entre tú y el otro extremo. Detrás de algunas redes necesitan un relé (un servidor TURN): introduce uno aquí si lo tienes.</string>
    <string name="relay_address">Relé (turn:host:puerto)</string>
    <string name="relay_user">Usuario del relé</string>
    <string name="relay_password">Contraseña del relé</string>
    <string name="relay_only">Siempre a través del relé</string>
    <string name="advanced_file_port">A un servidor cuya transferencia de archivos está en otro puerto (sus imágenes y avatares no cargan) se le puede poner su propio puerto en la parte Avanzado del favorito.</string>
    <string name="passwords_title">Contraseñas de canales</string>
    <string name="passwords_desc">Las contraseñas que elegiste recordar te unen a sus canales con un toque. Se guardan cifradas en este teléfono.</string>
    <string name="passwords_forget">Olvidar las contraseñas guardadas</string>
    <string name="passwords_forgotten">Olvidadas.</string>
    <string name="identity_title">Identidad de TeamSpeak</string>
    <string name="identity_desc">Tu identidad es quién eres para los servidores (tus grupos y permisos). Guarda una copia o usa la de otra app de TeamSpeak.</string>
    <string name="identity_wipe">Borrar</string>
    <string name="identity_export">Exportar</string>
    <string name="identity_import">Importar</string>
    <string name="identity_imported">Importada. Se usa a partir de la próxima conexión.</string>
    <string name="identity_saved">Guardada. Guarda el archivo donde solo tú tengas acceso.</string>
    <string name="identity_wiped">Borrada. Se crea una identidad nueva en la próxima conexión.</string>
    <string name="identity_export_title">Exportar tu identidad</string>
    <string name="identity_export_subtitle">Mantenla en privado</string>
    <string name="identity_save_file">Guardar en un archivo</string>
    <string name="identity_export_what">El archivo es tu propia identidad: quien lo tenga es tú en todos los servidores, con tus grupos y permisos, como los de un administrador del servidor. Nadie puede notar la diferencia.</string>
    <string name="identity_export_where">Guárdalo donde solo tú tengas acceso, como este teléfono o una unidad privada. No lo envíes por chat ni por correo y no lo publiques. Una app de TeamSpeak puede abrirlo, y también 回响 en otro teléfono.</string>
    <string name="identity_wipe_title">¿Borrar tu identidad?</string>
    <string name="identity_wipe_what">Se elimina la identidad de este teléfono y se crea una nueva la próxima vez que te conectes. Para todos los servidores serás alguien nuevo: tus grupos, permisos y todo lo que se le dio a tu identidad anterior (como derechos de administrador) no se conservan.</string>
    <string name="identity_wipe_back">La única forma de volver atrás es una copia exportada. Si puede que la necesites, cancela y expórtala primero.</string>
    <string name="identity_import_title">Importar una identidad</string>
    <string name="identity_import_subtitle">Desde una app de TeamSpeak</string>
    <string name="identity_import_desc">Pega la identidad que exportó una app de TeamSpeak o elige el archivo que guardó (.ini). Sustituye la identidad propia de este teléfono a partir de la próxima conexión.</string>
    <string name="identity_field">Identidad</string>
