    <plurals name="history_lines">
        <item quantity="one">%1$d línea</item>
        <item quantity="many">%1$d líneas</item>
        <item quantity="other">%1$d líneas</item>
    </plurals>
    <string name="history_clear">Borrar el historial del chat</string>
    <string name="history_cleared">Borrado.</string>
    <string name="history_clear_title">¿Borrar el historial del chat?</string>
    <string name="history_clear_button">Borrar</string>
    <string name="history_clear_desc">Se elimina de este teléfono el chat guardado de todos los servidores, y también el chat que se ve ahora.</string>

