    </plurals>
    <string name="history_clear">Очистить историю чата</string>
    <string name="history_cleared">Очищено.</string>
    <string name="history_clear_title">Очистить историю чата?</string>
    <string name="history_clear_button">Очистить</string>
    <string name="history_clear_desc">Сохранённый чат всех серверов удаляется с этого телефона, как и чат, который сейчас на экране.</string>

