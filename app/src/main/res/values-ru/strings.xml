    <string name="capture_noise">Убирать фоновый шум</string>
    <string name="capture_echo">Подавление эха</string>
    <string name="capture_agc">Автоматическая регулировка усиления</string>
    <string name="capture_echo_desc">С подавлением эха голоса звучат как в телефонном звонке (динамик или гарнитура). Выключите его для лучшего звука в наушниках.</string>

    <!-- Settings › UI -->
    <string name="ui_admin">Показывать функции администратора</string>
    <string name="ui_controls_bottom">Кнопки внизу</string>
    <string name="ui_controls_bottom_desc">Кнопки микрофона, звука и трансляции и переключатель Каналы/Чат находятся внизу экрана, под большим пальцем.</string>
    <string name="ui_language">Язык</string>
    <string name="ui_language_phone">Язык телефона</string>
    <string name="ui_admin_desc">В меню пользователя также можно переместить его в другой канал, выгнать из канала или с сервера и забанить. Сервер решает, разрешено ли вам это: без разрешения он откажет.</string>

    <!-- Settings › Advanced -->
    <string name="relay_title">Видеосоединение</string>
    <string name="relay_desc">Трансляции идут напрямую между вами и другой стороной. В некоторых сетях им нужен ретранслятор (TURN-сервер): укажите его здесь, если он у вас есть.</string>
    <string name="relay_address">Ретранслятор (turn:хост:порт)</string>
    <string name="relay_user">Имя пользователя ретранслятора</string>
    <string name="relay_password">Пароль ретранслятора</string>
    <string name="relay_only">Всегда через ретранслятор</string>
    <string name="advanced_file_port">Серверу, у которого передача файлов идёт через другой порт (его картинки и аватары не загружаются), можно задать свой порт в разделе «Дополнительно» избранного.</string>
    <string name="passwords_title">Пароли каналов</string>
    <string name="passwords_desc">Пароли, которые вы решили запомнить, позволяют войти в канал одним нажатием. Они хранятся на этом телефоне в зашифрованном виде.</string>
    <string name="passwords_forget">Забыть сохранённые пароли</string>
    <string name="passwords_forgotten">Забыты.</string>
    <string name="identity_title">Идентификатор TeamSpeak</string>
    <string name="identity_desc">Ваш идентификатор — это то, кем вы являетесь для серверов (ваши группы и разрешения). Сохраните копию или используйте идентификатор из другого приложения TeamSpeak.</string>
    <string name="identity_wipe">Удалить</string>
