    <string name="capture_vad_level">Pegel der Sprachaktivierung</string>
    <string name="capture_vad_level_desc">Nach rechts schieben, um Hintergrundgeräusche zu blockieren. Wenn deine Stimme abbricht, nach links schieben.</string>
    <string name="capture_vad_delay">Verzögerung vor dem Abschalten</string>
