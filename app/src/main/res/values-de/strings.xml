    <string name="capture_echo_desc">Mit Echounterdrückung klingen Stimmen wie in einem Anruf (Lautsprecher oder Headset). Schalte sie für den besten Klang mit Kopfhörern aus.</string>

    <!-- Settings › UI -->
    <string name="ui_admin">Admin-Funktionen anzeigen</string>
    <string name="ui_controls_bottom">Tasten unten</string>
    <string name="ui_controls_bottom_desc">Die Mikrofon-, Ton- und Teilen-Tasten und der Channels/Chat-Schalter sitzen unten auf dem Bildschirm, in Reichweite deines Daumens.</string>
    <string name="ui_language">Sprache</string>
    <string name="ui_language_phone">Sprache des Handys</string>
    <string name="ui_admin_desc">Das Menü einer Person bietet auch an, sie in einen anderen Channel zu verschieben, aus dem Channel oder vom Server zu kicken und sie zu bannen. Der Server entscheidet, ob du das darfst: Ohne die Berechtigung lehnt er ab.</string>

    <!-- Settings › Advanced -->
    <string name="relay_title">Videoverbindung</string>
    <string name="relay_desc">Streams laufen direkt zwischen dir und der Gegenseite. Hinter manchen Netzen brauchen sie ein Relay (einen TURN-Server): Trag hier eines ein, falls du eines hast.</string>
    <string name="relay_address">Relay (turn:host:port)</string>
    <string name="relay_user">Relay-Benutzername</string>
    <string name="relay_password">Relay-Passwort</string>
    <string name="relay_only">Immer über das Relay</string>
    <string name="advanced_file_port">Ein Server, dessen Dateiübertragung auf einem anderen Port läuft (seine Bilder und Avatare laden nicht), kann im Bereich Erweitert des Favoriten einen eigenen Port bekommen.</string>
    <string name="passwords_title">Channel-Passwörter</string>
    <string name="passwords_desc">Passwörter, die du dir merken lässt, betreten ihre Channels mit einem Tippen. Sie werden verschlüsselt auf diesem Handy gespeichert.</string>
    <string name="passwords_forget">Gespeicherte Passwörter vergessen</string>
    <string name="passwords_forgotten">Vergessen.</string>
    <string name="identity_title">TeamSpeak-Identität</string>
    <string name="identity_desc">Deine Identität ist, wer du für Server bist (deine Gruppen und Berechtigungen). Bewahre eine Kopie auf oder nutze die aus einer anderen TeamSpeak-App.</string>
    <string name="identity_wipe">Löschen</string>
    <string name="identity_export">Exportieren</string>
    <string name="identity_import">Importieren</string>
    <string name="identity_imported">Importiert. Sie wird ab der nächsten Verbindung verwendet.</string>
    <string name="identity_saved">Gespeichert. Bewahre die Datei dort auf, wo nur du hinkommst.</string>
    <string name="identity_wiped">Gelöscht. Bei der nächsten Verbindung wird eine neue Identität erstellt.</string>
    <string name="identity_export_title">Identität exportieren</string>
    <string name="identity_export_subtitle">Halte sie geheim</string>
    <string name="identity_save_file">In einer Datei speichern</string>
    <string name="identity_export_what">Die Datei ist deine Identität selbst: Wer sie hat, ist auf jedem Server du, mit deinen Gruppen und Berechtigungen, etwa denen eines Server-Admins. Niemand kann den Unterschied erkennen.</string>
    <string name="identity_export_where">Speichere sie dort, wo nur du hinkommst, etwa auf diesem Handy oder einem privaten Laufwerk. Schick sie nicht in einem Chat oder per E-Mail und veröffentliche sie nicht. Eine TeamSpeak-App kann sie öffnen, ebenso 回响 auf einem anderen Handy.</string>
    <string name="identity_wipe_title">Identität löschen?</string>
    <string name="identity_wipe_what">Die Identität dieses Handys wird gelöscht, und beim nächsten Verbinden wird eine neue erstellt. Für jeden Server bist du dann jemand Neues: Deine Gruppen, Berechtigungen und alles, was deiner alten Identität gegeben wurde (etwa Admin-Rechte), kommen nicht mit.</string>
    <string name="identity_wipe_back">Der einzige Weg zurück ist eine exportierte Kopie. Wenn du sie vielleicht noch brauchst, brich ab und exportiere sie zuerst.</string>
    <string name="identity_import_title">Identität importieren</string>
    <string name="identity_import_subtitle">Aus einer TeamSpeak-App</string>
    <string name="identity_import_desc">Füge die Identität ein, die eine TeamSpeak-App exportiert hat, oder wähle die gespeicherte Datei (.ini). Sie ersetzt ab der nächsten Verbindung die eigene Identität dieses Handys.</string>
    <string name="identity_field">Identität</string>
    <string name="identity_choose_file">Datei auswählen…</string>
    <string name="level_title">Sicherheitsstufe</string>
    <string name="level_desc">Manche Server lassen nur Identitäten ab einer bestimmten Stufe herein. Beim Erhöhen bleibt es dieselbe Identität, mit ihren Gruppen und Berechtigungen.</string>
    <string name="level_raise_button">Stufe erhöhen</string>

