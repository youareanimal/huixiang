    <!-- Settings › General -->
    <string name="avatar_title">Profile picture</string>
    <string name="avatar_change">Change</string>
    <string name="avatar_desc">Others see it on this server. It\'s made to fit 320 × 320.</string>
    <string name="general_floating_ptt">Floating push-to-talk button</string>
    <string name="general_floating_ptt_desc">In push-to-talk mode, a round button stays at the bottom of 回响\'s screen, so you can talk while you scroll the chat. The button over other apps (below) is a separate setting.</string>
    <string name="general_overlay_ptt">Talk button over other apps</string>
    <string name="general_overlay_ptt_desc">In push-to-talk mode, a round button shows when you go to other apps (not in 回响 itself). Hold it to talk, drag it to move it. Android asks once to let 回响 display over other apps.</string>
    <string name="general_volume_ptt">Volume buttons are push-to-talk</string>
    <string name="general_volume_ptt_desc">In push-to-talk mode, holding a volume button talks while the app is on screen (instead of changing the volume).</string>
    <string name="general_headset_ptt">Headset button is push-to-talk</string>
    <string name="general_headset_ptt_desc">In push-to-talk mode, press the button on your headphones to start talking and press it again to stop. Works with the screen off too. While it\'s on, the button doesn\'t play or pause music.</string>
    <string name="general_call_mute">Mute during phone calls</string>
    <string name="general_call_mute_desc">When a phone call rings or starts, your microphone and sound go off (and the sound of a stream you watch), and come back on when it ends. A stream you share pauses, so viewers don\'t see the call. Anything you had muted yourself stays muted.</string>
    <string name="general_updates">Check for updates</string>
    <string name="general_updates_desc">Once a day, 回响 asks GitHub whether a newer version is out, and says so on the connect screen. Nothing about you is sent.</string>
    <string name="general_screen_on">Keep the screen on</string>
    <string name="general_screen_on_desc">The screen doesn\'t go dark while you\'re connected and the app is open. While you share or watch a stream, it stays on anyway.</string>
    <string name="general_spacers">Allow joining spacer channels</string>
    <string name="general_spacers_desc">Tapping a spacer (a divider line or title in the channel list) joins it like any channel. Some servers use one as their AFK channel. Off, spacers can\'t be joined by a stray tap.</string>
    <string name="history_title">Chat history</string>
    <!-- %1$s is how many days (history_days), %2$s how many lines (history_lines) -->
    <string name="history_desc">Channel chats, private chats and who joined or left are kept on this phone, encrypted, and shown again when you connect to the same server: the last %1$s, at most %2$s per conversation. Pokes aren\'t kept.</string>
    <plurals name="history_days">
        <item quantity="one">%1$d day</item>
        <item quantity="other">%1$d days</item>
    </plurals>
    <plurals name="history_lines">
        <item quantity="one">%1$d line</item>
        <item quantity="other">%1$d lines</item>
    </plurals>
    <string name="history_clear">Clear chat history</string>
    <string name="history_cleared">Cleared.</string>
    <string name="history_clear_title">Clear chat history?</string>
    <string name="history_clear_button">Clear</string>
    <string name="history_clear_desc">Every server\'s saved chat is removed from this phone, and the chat on screen now.</string>

