    <string name="welcome_title">Your community, within reach</string>
    <string name="welcome_description">Voice, channels and chat for TeamSpeak 3 / 6 servers. Connect with a server address and a nickname.</string>
    <string name="connection_help">Connection guide</string>
    <string name="connection_help_body">Enter a hostname or IP address, optionally followed by :9987 (the default voice port). Use the voice port configured by the administrator, not the ServerQuery or file transfer port.\n\nYou can also paste a ts3server:// or teamspeak:// invitation here. Review its details before joining.\n\nA local TeamSpeak identity is created on this phone. In “Account &amp; cloud chat”, sign in with your myTeamSpeak email and password to sync friends and existing cloud conversations. Microphone permission is needed to speak.</string>
    <string name="fork_attribution">An independent client based on PocketTS • GPL-3.0. Not affiliated with TeamSpeak.</string>

