    <string name="capture_level">Level</string>
    <string name="capture_level_desc">The bar shows your microphone while these settings are open; nothing is sent meanwhile.</string>
    <string name="capture_vad_level">Voice activation level</string>
    <string name="capture_vad_level_desc">Slide right to block background noise. If your voice cuts out, slide left.</string>
    <string name="capture_vad_delay">Delay before deactivation</string>
    <string name="capture_processing">Signal processing</string>
    <string name="capture_noise">Remove background noise</string>
    <string name="capture_echo">Echo cancellation</string>
    <string name="capture_agc">Automatic gain control</string>
    <string name="capture_echo_desc">Echo cancellation plays voices like a phone call (loudspeaker, or your headset). Turn it off for the best sound with headphones.</string>

    <!-- Settings › UI -->
    <string name="ui_admin">Show admin functions</string>
    <string name="ui_controls_bottom">Buttons at the bottom</string>
    <string name="ui_controls_bottom_desc">The microphone, sound and share buttons and the Channels/Chat switch sit at the bottom of the screen, within reach of your thumb.</string>
    <string name="ui_language">Language</string>
    <string name="ui_language_phone">Phone\'s language</string>
    <string name="ui_admin_desc">A person\'s menu also offers moving them to another channel, kicking them from the channel or the server, and banning them. The server decides whether you\'re allowed: without the permission it says no.</string>

    <!-- Settings › Advanced -->
    <string name="relay_title">Video connection</string>
    <string name="relay_desc">Streams go straight between you and the other end. Behind some networks they need a relay (a TURN server): enter one here if you have it.</string>
    <string name="relay_address">Relay (turn:host:port)</string>
    <string name="relay_user">Relay username</string>
    <string name="relay_password">Relay password</string>
    <string name="relay_only">Always through the relay</string>
    <string name="advanced_file_port">A server whose file transfer is on another port (its pictures and avatars don\'t load) can have its own port in the favourite\'s Advanced part.</string>
    <string name="passwords_title">Channel passwords</string>
    <string name="passwords_desc">Passwords you chose to remember join their channels with one tap. They\'re kept on this phone, encrypted.</string>
    <string name="passwords_forget">Forget saved passwords</string>
    <string name="passwords_forgotten">Forgotten.</string>
    <string name="identity_title">TeamSpeak identity</string>
    <string name="identity_desc">Your identity is who you are to servers (your groups and permissions). Keep a copy, or use the one from another TeamSpeak app.</string>
    <string name="identity_wipe">Wipe</string>
    <string name="identity_export">Export</string>
    <string name="identity_import">Import</string>
    <string name="identity_imported">Imported. It\'s used from the next connect.</string>
    <string name="identity_saved">Saved. Keep the file somewhere only you can reach.</string>
    <string name="identity_wiped">Wiped. A new identity is made at the next connect.</string>
    <string name="identity_export_title">Export your identity</string>
    <string name="identity_export_subtitle">Keep it private</string>
    <string name="identity_save_file">Save to a file</string>
    <string name="identity_export_what">The file is your identity itself: anyone who has it is you on every server, with your groups and permissions, such as a server admin\'s. Nobody can tell the difference.</string>
    <string name="identity_export_where">Save it somewhere only you can reach, like this phone or a private drive. Don\'t send it in a chat or an email, and don\'t post it. A TeamSpeak app can open it, and so can 回响 on another phone.</string>
    <string name="identity_wipe_title">Wipe your identity?</string>
    <string name="identity_wipe_what">This phone\'s identity is deleted, and a new one is made the next time you connect. To every server you\'re then someone new: your groups, permissions and anything given to your old identity (such as admin rights) don\'t come along.</string>
    <string name="identity_wipe_back">The only way back is an exported copy. If you might want it again, cancel and Export it first.</string>
    <string name="identity_import_title">Import an identity</string>
    <string name="identity_import_subtitle">From a TeamSpeak app</string>
    <string name="identity_import_desc">Paste the identity a TeamSpeak app exported, or choose the file it saved (.ini). It replaces this phone\'s own from the next connect.</string>
    <string name="identity_field">Identity</string>
    <string name="identity_choose_file">Choose a file…</string>
    <string name="level_title">Security level</string>
    <string name="level_desc">Some servers only let in identities of at least a certain level. Raising it keeps the same identity, with its groups and permissions.</string>
    <string name="level_raise_button">Raise level</string>

