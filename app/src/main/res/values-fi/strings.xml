    <string name="capture_echo_desc">Kaiunpoisto toistaa äänet kuin puhelussa (kaiuttimesta tai kuulokemikrofonista). Kytke se pois, niin saat parhaan äänen kuulokkeilla.</string>

    <!-- Settings › UI -->
    <string name="ui_admin">Näytä ylläpitotoiminnot</string>
    <string name="ui_controls_bottom">Painikkeet alareunassa</string>
    <string name="ui_controls_bottom_desc">Mikrofoni-, ääni- ja jakopainikkeet sekä Kanavat/Keskustelu-valitsin ovat näytön alareunassa, peukalosi ulottuvilla.</string>
    <string name="ui_language">Kieli</string>
    <string name="ui_language_phone">Puhelimen kieli</string>
    <string name="ui_admin_desc">Henkilön valikossa voi myös siirtää hänet toiselle kanavalle, potkaista hänet kanavalta tai palvelimelta ja antaa porttikiellon. Palvelin päättää, onko sinulla lupa: ilman käyttöoikeutta se kieltäytyy.</string>

    <!-- Settings › Advanced -->
    <string name="relay_title">Videoyhteys</string>
    <string name="relay_desc">Striimit kulkevat suoraan sinun ja toisen pään välillä. Joidenkin verkkojen takaa ne tarvitsevat välityspalvelimen (TURN-palvelin): syötä se tähän, jos sinulla on sellainen.</string>
    <string name="relay_address">Välityspalvelin (turn:osoite:portti)</string>
    <string name="relay_user">Välityspalvelimen käyttäjänimi</string>
    <string name="relay_password">Välityspalvelimen salasana</string>
    <string name="relay_only">Aina välityspalvelimen kautta</string>
    <string name="advanced_file_port">Palvelimelle, jonka tiedonsiirto on toisessa portissa (sen kuvat ja profiilikuvat eivät lataudu), voi asettaa oman portin suosikin Lisäasetukset-osassa.</string>
    <string name="passwords_title">Kanavien salasanat</string>
    <string name="passwords_desc">Muistettaviksi valitsemasi salasanat liittävät kanaville yhdellä napautuksella. Ne säilytetään tässä puhelimessa salattuina.</string>
    <string name="passwords_forget">Unohda tallennetut salasanat</string>
    <string name="passwords_forgotten">Unohdettu.</string>
    <string name="identity_title">TeamSpeak-identiteetti</string>
    <string name="identity_desc">Identiteettisi on se, kuka olet palvelimille (ryhmäsi ja käyttöoikeutesi). Pidä siitä kopio tai käytä toisen TeamSpeak-sovelluksen identiteettiä.</string>
    <string name="identity_wipe">Poista</string>
    <string name="identity_export">Vie</string>
    <string name="identity_import">Tuo</string>
    <string name="identity_imported">Tuotu. Se otetaan käyttöön seuraavasta yhdistämisestä.</string>
    <string name="identity_saved">Tallennettu. Säilytä tiedosto paikassa, johon vain sinä pääset.</string>
    <string name="identity_wiped">Poistettu. Uusi identiteetti luodaan seuraavalla yhdistämiskerralla.</string>
    <string name="identity_export_title">Vie identiteettisi</string>
    <string name="identity_export_subtitle">Pidä se yksityisenä</string>
    <string name="identity_save_file">Tallenna tiedostoon</string>
    <string name="identity_export_what">Tiedosto on itse identiteettisi: kuka tahansa, jolla se on, on sinä jokaisella palvelimella ryhmineen ja käyttöoikeuksineen, kuten palvelimen ylläpitäjän oikeuksineen. Eroa ei voi huomata.</string>
    <string name="identity_export_where">Tallenna se paikkaan, johon vain sinä pääset, kuten tähän puhelimeen tai yksityiselle asemalle. Älä lähetä sitä keskustelussa tai sähköpostissa äläkä julkaise sitä. TeamSpeak-sovellus voi avata sen, samoin 回响 toisessa puhelimessa.</string>
    <string name="identity_wipe_title">Poistetaanko identiteettisi?</string>
    <string name="identity_wipe_what">Tämän puhelimen identiteetti poistetaan, ja uusi luodaan, kun seuraavan kerran yhdistät. Jokaiselle palvelimelle olet silloin uusi henkilö: ryhmäsi, käyttöoikeutesi ja kaikki vanhalle identiteetillesi annettu (kuten ylläpitäjän oikeudet) eivät siirry mukana.</string>
    <string name="identity_wipe_back">Ainoa tie takaisin on viety kopio. Jos saatat tarvita sitä vielä, peruuta ja vie se ensin.</string>
    <string name="identity_import_title">Tuo identiteetti</string>
    <string name="identity_import_subtitle">TeamSpeak-sovelluksesta</string>
    <string name="identity_import_desc">Liitä TeamSpeak-sovelluksen viemä identiteetti tai valitse sen tallentama tiedosto (.ini). Se korvaa tämän puhelimen oman identiteetin seuraavasta yhdistämisestä alkaen.</string>
    <string name="identity_field">Identiteetti</string>
    <string name="identity_choose_file">Valitse tiedosto…</string>
    <string name="level_title">Turvallisuustaso</string>
    <string name="level_desc">Jotkin palvelimet päästävät sisään vain identiteetit, joiden taso on vähintään tietty. Tason nostaminen säilyttää saman identiteetin ryhmineen ja käyttöoikeuksineen.</string>
    <string name="level_raise_button">Nosta tasoa</string>

