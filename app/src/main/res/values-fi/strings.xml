    <!-- Settings › General -->
    <string name="avatar_title">Profiilikuva</string>
    <string name="avatar_change">Vaihda</string>
    <string name="avatar_desc">Muut näkevät sen tällä palvelimella. Se sovitetaan kokoon 320 × 320.</string>
    <string name="general_floating_ptt">Kelluva puhepainike</string>
    <string name="general_floating_ptt_desc">Paina puhuaksesi -tilassa pyöreä painike pysyy 回响:n näytön alareunassa, joten voit puhua selatessasi keskustelua. Painike muiden sovellusten päällä (alla) on erillinen asetus.</string>
    <string name="general_overlay_ptt">Puhepainike muiden sovellusten päällä</string>
    <string name="general_overlay_ptt_desc">Paina puhuaksesi -tilassa pyöreä painike näkyy, kun siirryt muihin sovelluksiin (ei itse 回响:ssä). Pidä sitä pohjassa puhuaksesi, vedä siirtääksesi. Android pyytää kerran luvan näyttää 回响 muiden sovellusten päällä.</string>
    <string name="general_volume_ptt">Äänenvoimakkuuspainikkeet ovat puhepainikkeita</string>
    <string name="general_volume_ptt_desc">Paina puhuaksesi -tilassa äänenvoimakkuuspainikkeen pitäminen pohjassa lähettää puhetta, kun sovellus on näytöllä (äänenvoimakkuuden muuttamisen sijaan).</string>
    <string name="general_headset_ptt">Kuulokkeiden painike on puhepainike</string>
    <string name="general_headset_ptt_desc">Paina puhuaksesi -tilassa kuulokkeidesi painike aloittaa puhumisen ja toinen painallus lopettaa sen. Toimii myös näytön ollessa pois päältä. Kun tämä on päällä, painike ei toista eikä keskeytä musiikkia.</string>
    <string name="general_call_mute">Mykistä puhelun ajaksi</string>
    <string name="general_call_mute_desc">Kun puhelin soi tai puhelu alkaa, mikrofoni ja ääni menevät pois päältä (myös katsomasi striimin ääni) ja palaavat, kun puhelu päättyy. Jakamasi striimi tauotetaan, jotta katsojat eivät näe puhelua. Itse mykistämäsi pysyy mykistettynä.</string>
    <string name="general_updates">Tarkista päivitykset</string>
    <string name="general_updates_desc">Kerran päivässä 回响 kysyy GitHubilta, onko uudempi versio julkaistu, ja kertoo siitä yhdistämisnäkymässä. Sinusta ei lähetetä mitään.</string>
    <string name="general_screen_on">Pidä näyttö päällä</string>
    <string name="general_screen_on_desc">Näyttö ei sammu, kun olet yhdistettynä ja sovellus on auki. Kun jaat tai katsot striimiä, se pysyy päällä joka tapauksessa.</string>
    <string name="general_spacers">Salli liittyminen välikappaleisiin</string>
    <string name="general_spacers_desc">Välikappaleen (kanavalistan erotinviivan tai otsikon) napauttaminen liittyy siihen kuten mihin tahansa kanavaan. Jotkin palvelimet käyttävät sellaista AFK-kanavanaan. Pois päältä välikappaleisiin ei voi liittyä vahingossa napauttamalla.</string>
    <string name="history_title">Keskusteluhistoria</string>
    <string name="history_desc">Kanavakeskustelut, yksityiset keskustelut ja tiedot liittyneistä ja poistuneista säilytetään tässä puhelimessa salattuina, ja ne näytetään uudelleen, kun yhdistät samaan palvelimeen: viimeiset %1$s, enintään %2$s keskustelua kohden. Tökkäyksiä ei säilytetä.</string>
    <plurals name="history_days">
        <item quantity="one">%1$d päivä</item>
        <item quantity="other">%1$d päivää</item>
    </plurals>
    <plurals name="history_lines">
        <item quantity="one">%1$d rivi</item>
        <item quantity="other">%1$d riviä</item>
    </plurals>
    <string name="history_clear">Tyhjennä keskusteluhistoria</string>
    <string name="history_cleared">Tyhjennetty.</string>
    <string name="history_clear_title">Tyhjennetäänkö keskusteluhistoria?</string>
    <string name="history_clear_button">Tyhjennä</string>
    <string name="history_clear_desc">Kaikkien palvelimien tallennetut keskustelut poistetaan tästä puhelimesta, samoin nyt näytöllä oleva keskustelu.</string>

