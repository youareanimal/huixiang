    <string name="capture_level">Taso</string>
    <string name="capture_level_desc">Palkki näyttää mikrofonisi tason, kun nämä asetukset ovat auki; sillä välin mitään ei lähetetä.</string>
    <string name="capture_vad_level">Puheaktivoinnin taso</string>
    <string name="capture_vad_level_desc">Liu\'uta oikealle estääksesi taustamelun. Jos äänesi katkeilee, liu\'uta vasemmalle.</string>
    <string name="capture_vad_delay">Viive ennen katkaisua</string>
