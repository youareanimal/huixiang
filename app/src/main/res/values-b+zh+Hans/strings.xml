    <string name="relay_only">始终通过中继</string>
    <string name="advanced_file_port">如果某个服务器的文件传输使用其他端口（其图片和头像无法加载），可以在该收藏的「高级」部分为它设置专用端口。</string>
    <string name="passwords_title">频道密码</string>
    <string name="passwords_desc">你选择记住的密码可一键加入对应频道。它们会加密保存在这部手机上。</string>
    <string name="passwords_forget">忘记已保存的密码</string>
    <string name="passwords_forgotten">已忘记。</string>
    <string name="identity_title">TeamSpeak 身份</string>
    <string name="identity_desc">你的身份代表你在服务器上的身份（你的组和权限）。请保留一份副本，或使用其他 TeamSpeak 应用中的身份。</string>
    <string name="identity_wipe">清除</string>
    <string name="identity_export">导出</string>
    <string name="identity_import">导入</string>
    <string name="identity_imported">已导入。将从下次连接起使用。</string>
    <string name="identity_saved">已保存。请将文件保存在只有你能访问的地方。</string>
    <string name="identity_wiped">已清除。下次连接时会创建新身份。</string>
    <string name="identity_export_title">导出你的身份</string>
    <string name="identity_export_subtitle">请妥善保密</string>
    <string name="identity_save_file">保存到文件</string>
    <string name="identity_export_what">该文件就是你的身份本身：任何拥有它的人在每个服务器上都会被当作你，拥有你的组和权限，例如服务器管理员的权限。没有人能分辨出区别。</string>
