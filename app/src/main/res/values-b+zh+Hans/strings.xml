    <!-- Settings › General -->
    <string name="avatar_title">头像</string>
    <string name="avatar_change">更换</string>
    <string name="avatar_desc">其他人会在此服务器上看到它。它会被裁剪为 320 × 320。</string>
    <string name="general_floating_ptt">悬浮按键说话按钮</string>
    <string name="general_floating_ptt_desc">在按键说话模式下，一个圆形按钮会停留在 回响 屏幕底部，让你在滚动聊天时也能说话。显示在其他应用上方的按钮（见下方）是单独的设置。</string>
    <string name="general_overlay_ptt">在其他应用上方显示说话按钮</string>
    <string name="general_overlay_ptt_desc">在按键说话模式下，当你切换到其他应用时（回响 本身内不显示）会出现一个圆形按钮。按住它说话，拖动它可移动位置。Android 会询问一次是否允许 回响 显示在其他应用上方。</string>
    <string name="general_volume_ptt">音量键用于按键说话</string>
    <string name="general_volume_ptt_desc">在按键说话模式下，当应用显示在屏幕上时，按住音量键即可说话（而不是调节音量）。</string>
    <string name="general_headset_ptt">耳机按钮用于按键说话</string>
    <string name="general_headset_ptt_desc">在按键说话模式下，按一下耳机上的按钮开始说话，再按一下停止。屏幕关闭时也有效。开启后，该按钮不会播放或暂停音乐。</string>
    <string name="general_call_mute">通话时静音</string>
    <string name="general_call_mute_desc">来电响铃或通话开始时，麦克风和声音会关闭（包括你正在观看的直播的声音），通话结束后恢复。你共享的直播会暂停，观众看不到来电。你自己静音的仍保持静音。</string>
    <string name="general_updates">检查更新</string>
    <string name="general_updates_desc">回响 每天会向 GitHub 询问一次是否有新版本，并在连接界面上提示。不会发送任何关于你的信息。</string>
    <string name="general_screen_on">保持屏幕常亮</string>
    <string name="general_screen_on_desc">在你已连接且应用打开时，屏幕不会变暗。在你分享或观看直播时，屏幕总是保持常亮。</string>
    <string name="general_spacers">允许加入间隔频道</string>
    <string name="general_spacers_desc">轻触间隔（频道列表中的分隔线或标题）会像加入普通频道一样加入它。有些服务器把它用作 AFK 频道。关闭时，误触不会加入间隔。</string>
    <string name="history_title">聊天记录</string>
    <string name="history_desc">频道聊天、私聊以及谁加入或离开的记录会加密保存在这部手机上，当你连接到同一个服务器时会再次显示：保留最近 %1$s，每个会话最多 %2$s。戳一下不会保存。</string>
    <plurals name="history_days">
        <item quantity="other">%1$d 天</item>
    </plurals>
    <plurals name="history_lines">
        <item quantity="other">%1$d 条</item>
    </plurals>
