    <string name="history_cleared">已清除。</string>
    <string name="history_clear_title">清除聊天记录？</string>
    <string name="history_clear_button">清除</string>
    <string name="history_clear_desc">所有服务器保存的聊天记录都会从这部手机上删除，当前屏幕上的聊天也会清除。</string>

